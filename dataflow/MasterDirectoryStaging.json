{
	"name": "MasterDirectoryStaging",
	"properties": {
		"description": "Includes: Master School, Master District and manual Charter files",
		"folder": {
			"name": "MasterSchoolDir"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "WASchoolsDirectory",
						"type": "DatasetReference"
					},
					"name": "WASchoolDirectory"
				},
				{
					"dataset": {
						"referenceName": "CharterSchoolDirectory",
						"type": "DatasetReference"
					},
					"name": "Charter"
				},
				{
					"dataset": {
						"referenceName": "MasterDistrictDirectory",
						"type": "DatasetReference"
					},
					"name": "MasterDistrictDir"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "EducationData",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "EducationData",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				},
				{
					"linkedService": {
						"referenceName": "EducationData",
						"type": "LinkedServiceReference"
					},
					"name": "sink3"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          ESDCode as string,",
				"          ESDName as string,",
				"          LEACode as string,",
				"          LEAName as string,",
				"          SchoolCode as string,",
				"          SchoolName as string,",
				"          LowestGrade as string,",
				"          HighestGrade as string,",
				"          AddressLine1 as string,",
				"          AddressLine2 as string,",
				"          City as string,",
				"          State as string,",
				"          ZipCode as string,",
				"          PrincipalName as string,",
				"          Email as string,",
				"          Phone as string,",
				"          OrgCategoryList as string,",
				"          AYPCode as string,",
				"          GradeCategory as string,",
				"          TransitionToKindergarten as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> WASchoolDirectory",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Charter",
				"source(output(",
				"          Column_1 as string,",
				"          Column_2 as string,",
				"          Column_3 as string,",
				"          Column_4 as string,",
				"          Column_5 as string,",
				"          Column_6 as string,",
				"          Column_7 as string,",
				"          Column_8 as string,",
				"          Column_9 as string,",
				"          Column_10 as string,",
				"          Column_11 as string,",
				"          Column_12 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> MasterDistrictDir",
				"WASchoolDirectory sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'staging',",
				"     tableName: 'MasterSchoolDirectory',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"Charter sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'staging',",
				"     tableName: 'CharterSchoolDirectory',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2",
				"MasterDistrictDir sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'staging',",
				"     tableName: 'MasterDistrictDirectory',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink3"
			]
		}
	}
}